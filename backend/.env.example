# Copy to .env for local work. On Render, set these as environment variables instead (never commit the real values).

# MongoDB Atlas connection string (MONGODB_URI also works as the name)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hvu?retryWrites=true&w=majority

# The admin account is NOT set here. It lives in the database and is created or changed with `npm run set-admin`
# (needs MONGO_URI, so only someone who can reach the database can do it).

# Production only: the website address(es) allowed to call this API, comma separated. Leave unset locally.
# CORS_ORIGIN=https://khoa-tieng-anh-hvu.<account>.workers.dev,https://www.example.edu.vn

# Render sets PORT itself. TRUST_PROXY=1 (default) is right behind Render; use 0 when nothing sits in front.
# PORT=5000
# TRUST_PROXY=1
