{
  "name": "blog-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm --prefix ../backend run dev\" \"node scripts/wait-api.cjs && vite\"",
    "web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler pages deploy --branch main --commit-dirty=true",
    "roundtrip": "node scripts/roundtrip.mjs",
    "test:admin": "node scripts/admin-order.test.mjs && node scripts/admin-filter.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "vite": "^5.2.8",
    "wrangler": "^4.151.1"
  }
}
