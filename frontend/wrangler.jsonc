{
  // Cloudflare Pages: publishes the built site from ./dist as https://khoangoaingu.pages.dev
  // Paths that exist only in the browser (/quan-tri, /muc/dao-tao) return index.html by themselves,
  // as long as the site has no 404.html of its own.
  "name": "khoangoaingu",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-16"
}
