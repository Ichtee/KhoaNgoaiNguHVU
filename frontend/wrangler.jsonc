{
  // Cloudflare Workers static assets: serves the built site from ./dist
  "name": "khoa-tieng-anh-hvu",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./dist/",
    // pages like /quan-tri or /muc/dao-tao exist only in the browser, so unknown paths must return index.html
    "not_found_handling": "single-page-application"
  }
}
